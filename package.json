{
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "body-parser": "^2.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql": "^2.18.1",
    "mysql2": "^3.24.5",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5"
  },
  "scripts": {
    "start": "node back-end/server.js",
    "migrate:deploy": "node back-end/scripts/migrateDeployment.js",
    "test": "node --test back-end/tests/*.test.js",
    "build:ui": "npm --prefix front-end run build",
    "desktop:dev": "electron .",
    "desktop:dist": "electron-builder --win nsis --x64",
    "desktop:postinstall": "electron-builder install-app-deps"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "name": "magno-dental-desktop-migration",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.magno.dental.desktop",
    "productName": "Magno Dental Management",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "front-end/dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Magno-Dental-Setup-${version}.${ext}"
    }
  }
}
