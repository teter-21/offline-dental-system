{
  "name": "magno-dental-desktop-migration",
  "version": "0.1.0",
  "description": "Offline desktop dental management system for Magno Dental Clinic, built with Electron, React, Express, and SQLite.",
  "private": true,
  "main": "desktop/main.cjs",
  "type": "commonjs",
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "node back-end/server-sqlite.js",
    "migrate:deploy": "node back-end/scripts/migrateDeployment.js",
    "test": "node --test back-end/tests/*.test.js",
    "build:ui": "npm --prefix front-end run build",
    "build:ui:desktop": "npm --prefix front-end run build -- --mode desktop",
    "desktop:dev": "electron .",
    "desktop:preview": "cross-env MAGNO_PREVIEW_BUILD=1 electron .",
    "desktop:pack": "electron-builder --dir --win --x64",
    "desktop:dist": "electron-builder --win nsis --x64",
    "desktop:postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "body-parser": "^2.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.0.0",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "com.magno.dental.desktop",
    "productName": "Magno Dental Management",
    "asar": true,
    "npmRebuild": true,
    "nodeGypRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*.cjs",
      "front-end/dist/**/*",
      "back-end/**/*.js",
      "package.json",
      "node_modules/**/*",
      "!back-end/tests/**",
      "!back-end/scripts/**",
      "!back-end/data/**",
      "!back-end/storage/**",
      "!back-end/backups/**",
      "!back-end/recovery/**",
      "!**/*.db",
      "!**/*.db-wal",
      "!**/*.db-shm",
      "!**/*.db-journal",
      "!**/*.sqlite",
      "!**/*.sqlite-wal",
      "!**/*.sqlite-shm",
      "!**/.env",
      "!**/.env.*",
      "!**/*.pem",
      "!**/*.key",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "packaging/seed",
        "to": "seed",
        "filter": [
          "clinic_initial.db"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/bcrypt/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Magno-Dental-Setup-${version}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teter-21/offline-dental-system.git"
  },
  "keywords": [
    "dental-management",
    "electron",
    "sqlite",
    "offline-desktop",
    "react"
  ],
  "bugs": {
    "url": "https://github.com/teter-21/offline-dental-system/issues"
  },
  "homepage": "https://github.com/teter-21/offline-dental-system#readme"
}
